{
  "name": "easyserp",
  "version": "1.0.0",
  "description": "Google and Bing search for AI agents: JavaScript client, CLI, MCP server and portable Skill.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "exports": {
    ".": "./src/client.mjs",
    "./mcp": "./src/mcp.mjs"
  },
  "bin": {
    "easyserp": "./src/cli.mjs",
    "easyserp-mcp": "./src/mcp.mjs"
  },
  "files": [
    "src",
    "skills/easyserp",
    "README.md",
    "README.en.md",
    "docs",
    "assets",
    "LICENSE",
    ".claude-plugin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "mcp": "node src/mcp.mjs",
    "skill:prepare": "node scripts/prepare-skill.mjs",
    "release:pack": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "prepack": "node scripts/prepare-skill.mjs"
  },
  "keywords": [
    "easyserp",
    "mcp",
    "search",
    "google",
    "bing",
    "ai-agent",
    "serp",
    "skill"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aiispower/easyserp.git"
  },
  "homepage": "https://serp.skyvora.cc",
  "bugs": {
    "url": "https://github.com/aiispower/easyserp/issues"
  }
}
